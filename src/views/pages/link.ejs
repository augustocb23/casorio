<!DOCTYPE html>
<html lang="pt-br">
<%- include('../components/head'); %>

<body>
<%- include('../components/header', { showTitle: true }); %>
<%- include('../components/background-images'); %>

<div class="text-box">
    <form id="form">
        <div class="input-group">
            <label for="change-code">Código:</label>
            <input id="change-code" name="changeCode" type="password"/>
        </div>

        <div class="input-group">
            <label for="link">Link:</label>
            <input id="link" name="link" type="text"/>
        </div>

        <div class="input-group">
            <label for="meeting-id">ID da reunião:</label>
            <input id="meeting-id" name="id" type="text"/>
        </div>

        <div class="input-group">
            <label for="meeting-password">Senha da reunião:</label>
            <input id="meeting-password" name="password" type="text"/>
        </div>

        <div class="buttons">
            <button class="delete" type="button" onclick="deleteLink()">Excluir link</button>
            <button class="default" type="submit">Salvar</button>
        </div>
    </form>
</div>
</body>

<script type="application/javascript">
  document.getElementById('form')
    .addEventListener('submit', async e => {
      e.preventDefault();

      const headers = new Headers();
      headers.append("Content-Type", "application/json");

      const form = e.currentTarget;
      const formData = new FormData(form);
      const plainFormData = Object.fromEntries(formData.entries());
      const body = JSON.stringify(plainFormData);

      const response = await fetch('/meetings', {method: 'POST', headers, body});
      if (response.status === 200)
        document.location.href = '/';
    });

  async function deleteLink() {
    const headers = new Headers();
    headers.append("Content-Type", "application/json");

    const {value: changeCode} = document.getElementById('change-code');
    const body = JSON.stringify({changeCode});

    const response = await fetch('/meetings', {method: 'DELETE', headers, body});
    if (response.status === 204)
      document.location.href = '/';
  }
</script>
